{
  "_comment": "spaCy dependency label -> SGF semantic role mapping. The role inventory is CLOSED at 15 (see sgflib.ROLES). This file maps the open vocabulary of spaCy dependency labels into that closed inventory. Keys starting with '_' are ignored.",
  "_doc_url": "https://spacy.io/api/dependencyparser",
  "_grammar_anchor": "sgflib.ROLES is the source of truth for the 15-role inventory",

  "_CORE_AGENT_ROLES_": null,
  "nsubj":      "HAS_AGENT",
  "agent":      "HAS_AGENT",
  "csubj":      "HAS_AGENT",

  "_CORE_PATIENT_ROLES_": null,
  "nsubjpass":  "HAS_PATIENT",
  "csubjpass":  "HAS_PATIENT",
  "dobj":       "HAS_PATIENT",
  "obj":        "HAS_PATIENT",

  "_CORE_RECIPIENT_ROLES_": null,
  "iobj":       "HAS_RECIPIENT",
  "dative":     "HAS_RECIPIENT",

  "_THEME_ROLES_": null,
  "ccomp":      "HAS_THEME",
  "xcomp":      "HAS_THEME",
  "pcomp":      "HAS_THEME",
  "oprd":       "HAS_THEME",
  "appos":      "HAS_THEME",

  "_ATTRIBUTE_ROLES_": null,
  "attr":       "HAS_ATTRIBUTE",
  "acomp":      "HAS_ATTRIBUTE",
  "amod":       "HAS_ATTRIBUTE",

  "_MANNER_ROLES_": null,
  "advmod":     "HAS_MANNER",
  "npadvmod":   "HAS_MANNER",

  "_COMMENT_pobj_": "pobj is handled specially by clause_to_synapse.py via the preposition lemma; not directly mapped here",

  "_IGNORED_DEPS_": null,
